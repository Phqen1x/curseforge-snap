#!/bin/bash

CMD="sudo snap connect curseforge:network-observe"

if ! snapctl is-connected network-observe; then
    output=$(zenity --error \
        --title="CurseForge – Permission Required" \
        --width=500 \
        --text="CurseForge requires the <b>network-observe</b> permission to start.\n\nRun the following command in a terminal, then relaunch CurseForge:\n\n<tt>$CMD</tt>" \
        --extra-button="Copy Command" \
        2>/dev/null)

    if [ "$output" = "Copy Command" ]; then
        printf '%s' "$CMD" | xclip -selection clipboard 2>/dev/null || \
        printf '%s' "$CMD" | wl-copy --paste-once 2>/dev/null &
    fi
    exit 1
fi

_check_update() {
    local current="$SNAP_VERSION"
    [ -z "$current" ] && return

    local latest
    latest=$(curl -sf --max-time 8 \
        -H "Snap-Device-Series: 16" \
        "https://api.snapcraft.io/v2/snaps/info/curseforge" 2>/dev/null | \
        "$SNAP/usr/bin/jq" -r \
        '[.["channel-map"][] | select(.channel.name == "stable")] | first | .version' \
        2>/dev/null)

    [ -z "$latest" ] || [ "$latest" = "null" ] || [ "$latest" = "$current" ] && return

    zenity --question \
        --title="CurseForge Update Available" \
        --width=450 \
        --text="A new version of CurseForge is available!\n\n<b>Installed:</b>  $current\n<b>Available:</b>  $latest\n\nWould you like to update now? CurseForge will close and reopen after the update." \
        --ok-label="Update Now" \
        --cancel-label="Skip" \
        2>/dev/null || return

    # Try polkit-authenticated snap refresh
    if command -v pkexec &>/dev/null && \
       pkexec /usr/bin/snap refresh curseforge --channel=stable 2>/dev/null; then
        zenity --info \
            --title="Update Complete" \
            --width=380 \
            --text="CurseForge has been updated to <b>$latest</b>.\n\nPlease relaunch the app from your application menu." \
            2>/dev/null
        exit 0
    fi

    # Fallback: show copy-command dialog
    local refresh_cmd="sudo snap refresh curseforge"
    local output
    output=$(zenity --warning \
        --title="Manual Update Required" \
        --width=500 \
        --text="Automatic update requires elevated permissions.\n\nRun the following command in a terminal, then relaunch CurseForge:\n\n<tt>$refresh_cmd</tt>" \
        --extra-button="Copy Command" \
        2>/dev/null)
    if [ "$output" = "Copy Command" ]; then
        printf '%s' "$refresh_cmd" | xclip -selection clipboard 2>/dev/null || \
        printf '%s' "$refresh_cmd" | wl-copy --paste-once 2>/dev/null &
    fi
}

_check_update

exec "$SNAP/opt/CurseForge/curseforge" --no-sandbox "$@"
